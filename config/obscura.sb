(version 1)
(allow default)
; Web content must not inherit access to personal files or launch other programs.
(deny file-read* file-write* (subpath "/Users") (subpath "/Volumes")
  (subpath "/private/var/folders") (subpath "/private/tmp"))
(allow file-read* (subpath (param "OBSCURA_ROOT")))
(deny process-exec)
(allow process-exec (literal (param "OBSCURA_EXEC")))
