+  const isIPv6 = (addr.match(/:/g)?.length ?? 0) >= 2;
+  return isIPv6 ? `[${addr}]` : addr;
+}
+
+/**
+ * Re-resolve the CoreDevice IPv6 and reuse the already-rotated bearer.
+ *
+ * A USB flap or a hung `/elements` dump often drops the route without
+ * killing Pulse. Full `bootstrapTunnel` then sees a running app with no
+ * on-disk boot token and relaunches it, which wipes the in-memory session
+ * lock (`session_invalid_or_expired` on the next tap). Prefer this reuse
+ * path whenever `/healthz` plus an authenticated `/state/snapshot` still
+ * succeed with the cached token.
+ */
+export async function reuseRotatedTunnel(opts: {
+  failed: DeviceTunnel;
+  spawn?: SpawnImpl;
+  fetchImpl?: typeof fetch;
+}): Promise<DeviceTunnel | null> {
+  const ipv6 = getDeviceTunnelIPv6FromDevicectl(opts.failed.udid, opts.spawn);
+  if (!ipv6) return null;
+
+  const fetchFn = opts.fetchImpl ?? fetch;
+  const base = `http://${formatTunnelHost(ipv6)}:${opts.failed.port}`;
+  try {
+    const health = await fetchFn(`${base}/healthz`, {
+      signal: AbortSignal.timeout(2_000),
+    });
+    if (!health.ok) return null;
+
+    const snap = await fetchFn(`${base}/state/snapshot`, {
+      headers: { Authorization: `Bearer ${opts.failed.bootTokenRotated}` },
+      signal: AbortSignal.timeout(3_000),
+    });
+    // 401 means the process was replaced and the rotated token died — caller
+    // must take the hard bootstrap / relaunch path.
+    if (!snap.ok) return null;
+
+    return { ...opts.failed, ipv6Addr: ipv6 };
+  } catch {
+    return null;
+  }
+}
