#!/usr/bin/env python3
"""Report agent leftovers (worktrees, branches, stale node_modules, unavailable
simulators) and, with --apply, remove only what is provably safe.

A finished worktree (clean, and its tip is a merged PR's head or its branch's
remote was deleted after merging) is removed at any age; any worktree idle for
--days (default 5) is dead and removed with its branch, uncommitted and unmerged
work included. Either way it must sit inside the scanned folders, is not on
the default branch, and has no ignored files beyond rebuildable folders and junk
such as .DS_Store (any other ignored file could be a secret). Locked worktrees
and ones a process works in are kept. A branch with no worktree is removed only
when it is merged: its tip is an ancestor of origin's default branch, or a merged
PR on GitHub has exactly that tip as its head (squash merges). Scratch entries
under the shared scratch folder idle for --days are removed too.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Dict, List, Optional, Set, Tuple

# The shared worktree folder and project checkouts, plus older places agents and apps left worktrees.
DEFAULT_ROOTS = ["~/Metisary/Enviroment/worktrees", "~/Metisary/Projects", "~/Development", "~/.cursor/worktrees",
                 "~/.codex/worktrees", "~/.t3/worktrees", "~/conductor", "~/orca", "~/emdash", "/private/tmp"]
SKIP_DIRS = {"node_modules", ".build", "DerivedData", "Pods", ".venv"}
# Ignored folders that rebuild themselves; any other ignored file (such as .env) keeps a worktree.
REBUILDABLE = SKIP_DIRS | {"dist", "build", ".next", ".turbo", ".cache", "coverage", "__pycache__", ".ruff_cache",
                           ".pytest_cache", ".mypy_cache", "test-results", ".deriveddata", ".vite-hooks"}
JUNK_FILES = {".DS_Store", ".coverage"}
# Ignored generated output: XcodeGen projects and code generators' *.gen.ts files.
REBUILDABLE_SUFFIXES = (".xcodeproj",)
JUNK_SUFFIXES = (".gen.ts",)


def rebuildable(name: str) -> bool:
    return name in REBUILDABLE or name.endswith(REBUILDABLE_SUFFIXES)


def junk_file(name: str) -> bool:
    return name in JUNK_FILES or name.endswith(JUNK_SUFFIXES)
SCRATCH_ROOT = "~/Metisary/Enviroment/scratch"
SCRATCH_DEPTH = 3  # e.g. claude/claude-501/<project>/<session>: descend past active parents
FETCH_TIMEOUT_S = 60


def run(args: List[str], cwd: Optional[Path] = None, timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=timeout)


def git(repo: Path, *args: str, timeout: int = 60) -> str:
    out = run(["git", "-C", str(repo), *args], timeout=timeout)
    return out.stdout.strip() if out.returncode == 0 else ""


def git_ok(repo: Path, *args: str) -> bool:
    return run(["git", "-C", str(repo), *args]).returncode == 0


def size_kb(path: Path) -> int:
    out = run(["du", "-sk", str(path)], timeout=600)
    return int(out.stdout.split()[0]) if out.returncode == 0 and out.stdout else 0


def human(kb: int) -> str:
    return f"{kb / 1048576:.1f}G" if kb >= 1048576 else f"{kb / 1024:.0f}M"


def find_repos(roots: List[Path], depth: int = 4) -> List[Path]:
    """Return one path per distinct repository (its common git dir's parent work tree)."""
    commons: Dict[str, Path] = {}
    for root in roots:
        if not root.is_dir():
            continue
        stack = [(root, 0)]
        while stack:
            d, level = stack.pop()
            if (d / ".git").exists():
                common = git(d, "rev-parse", "--path-format=absolute", "--git-common-dir")
                if common and common not in commons:
                    commons[common] = d
                continue
            if level >= depth:
                continue
            try:
                kids = [k for k in d.iterdir() if k.is_dir() and not k.is_symlink() and k.name not in SKIP_DIRS]
            except OSError:
                continue
            stack.extend((k, level + 1) for k in kids)
    return list(commons.values())


def process_cwds() -> Optional[List[str]]:
    """Working directories of this user's processes, or None if they can't be read."""
    try:
        out = run(["lsof", "-a", "-d", "cwd", "-Fn", "-u", str(os.getuid())], timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    paths = [line[1:] for line in out.stdout.splitlines() if line.startswith("n")]
    return paths if out.returncode == 0 and paths else None


def is_junk(wt: Path, entry: str) -> bool:
    """True for ignored junk files and anything inside a rebuildable folder at any depth."""
    parts = entry.rstrip("/").split("/")
    if junk_file(parts[-1]):
        return True
    return any(rebuildable(name) and (wt.joinpath(*parts[: i + 1])).is_dir() for i, name in enumerate(parts))


def walk_blocker(wt: Path, entry: str, need_junk: bool) -> str:
    """Why a folder git reports as one entry must be kept: a nested repository (git can't see its
    ignored files), or with need_junk a file that is not junk. '' if neither."""
    top = wt / entry.rstrip("/")
    if not top.is_dir() or top.is_symlink():
        return "" if not need_junk else f"ignored file {entry} (could be secrets)"
    for root, dirs, files in os.walk(top):
        if ".git" in dirs or ".git" in files:
            return f"nested repository {Path(root).relative_to(wt)}"
        dirs[:] = [d for d in dirs if not rebuildable(d)]
        odd = next((f for f in files if not junk_file(f)), None)
        if need_junk and odd:
            return f"ignored file {(Path(root) / odd).relative_to(wt)} (could be secrets)"
    return ""


def worktree_state(wt: Path) -> Optional[Tuple[bool, str]]:
    """(has uncommitted changes, why its files must be kept or ''), or None if git couldn't tell."""
    out = run(["git", "-C", str(wt), "status", "--porcelain", "-z", "--ignored"])
    if out.returncode != 0:
        return None
    if (wt / ".gitmodules").exists():
        return True, "has submodules (git can't see their ignored files)"
    dirty = False
    tokens = iter(out.stdout.split("\0"))
    for tok in tokens:
        if not tok:
            continue
        code, entry = tok[:2], tok[3:]
        if code[0] in "RC":
            next(tokens, None)  # -z puts a rename's original path in its own field
        if code == "!!":
            why = "" if is_junk(wt, entry) else walk_blocker(wt, entry, need_junk=True)
        else:
            dirty = True
            why = walk_blocker(wt, entry, need_junk=False) if entry.endswith("/") else ""
        if why:
            return dirty, why
    return dirty, ""


def default_ref(repo: Path) -> Optional[str]:
    ref = git(repo, "symbolic-ref", "--quiet", "refs/remotes/origin/HEAD")
    if ref:
        return ref
    for name in ("refs/remotes/origin/main", "refs/remotes/origin/master"):
        if git_ok(repo, "rev-parse", "--verify", "--quiet", name):
            return name
    return None


def merged_pr_heads(repo: Path) -> Optional[Dict[str, Set[str]]]:
    """Head SHA -> head branch names of merged PRs whose head repository is this one (not a fork), so
    squash-merged branches can be recognised. None when the lookup failed."""
    url = git(repo, "remote", "get-url", "origin")
    if "github.com" not in url:
        return {}
    slug = url.split("github.com")[-1].lstrip(":/").removesuffix(".git")
    gh = os.environ.get("AGENT_SWEEP_GH", "gh")
    try:
        out = run([gh, "pr", "list", "-R", slug, "--state", "merged", "--limit", "1000",
                   "--json", "headRefOid,headRefName,headRepository,headRepositoryOwner"], timeout=120)
        if out.returncode != 0:
            return None
        heads: Dict[str, Set[str]] = {}
        for pr in json.loads(out.stdout or "[]"):
            head = f'{(pr.get("headRepositoryOwner") or {}).get("login", "")}/{(pr.get("headRepository") or {}).get("name", "")}'
            if head.lower() == slug.lower():
                heads.setdefault(pr["headRefOid"], set()).add(pr.get("headRefName", ""))
        return heads
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


class Repo:
    def __init__(self, path: Path, fetch: bool) -> None:
        self.path = path
        self.fetch_failed = False
        if fetch:
            try:
                done = run(["git", "-C", str(path), "fetch", "--prune", "--quiet", "origin"], timeout=FETCH_TIMEOUT_S)
                self.fetch_failed = done.returncode != 0
            except subprocess.TimeoutExpired:
                self.fetch_failed = True
        self.base = default_ref(path)
        self.pr_heads: Optional[Dict[str, Set[str]]] = None
        self.pr_lookup_failed = False

    def merged(self, sha: str) -> bool:
        # Stale refs or an unknown default branch can't prove anything is merged.
        if self.fetch_failed or not self.base:
            return False
        if git_ok(self.path, "merge-base", "--is-ancestor", sha, self.base):
            return True
        return sha in self.prs()

    def prs(self) -> Dict[str, Set[str]]:
        if self.pr_heads is None:
            heads = merged_pr_heads(self.path)
            self.pr_lookup_failed = heads is None
            self.pr_heads = heads or {}
        return self.pr_heads

    def finished(self, sha: str, branch: str) -> bool:
        """This branch's own work landed: its merged PR, or its own remote branch deleted after
        merging. A fresh worktree on the default branch, or a new branch started from another
        branch's merged tip, is not finished."""
        if not branch or not self.merged(sha):
            return False
        # The branch's oldest reflog entry is where it was created; no commits since means no work.
        created = git(self.path, "reflog", "show", "--format=%H", f"refs/heads/{branch}").splitlines()
        if not created or created[-1] == sha:
            return False
        if branch in self.prs().get(sha, set()):
            return True
        upstream = git(self.path, "for-each-ref", "--format=%(upstream:short) %(upstream:track)", f"refs/heads/{branch}")
        return upstream == f"origin/{branch} [gone]"

    def unpushed(self, sha: str) -> int:
        out = git(self.path, "rev-list", "--count", sha, "--not", "--remotes")
        return int(out or 0)


def worktrees(repo: Path) -> List[Dict[str, str]]:
    items, cur = [], {}
    for line in git(repo, "worktree", "list", "--porcelain").splitlines() + [""]:
        if not line:
            if cur:
                items.append(cur)
            cur = {}
            continue
        key, _, value = line.partition(" ")
        cur[key] = value or "1"
    return items


def last_activity(wt: Path) -> float:
    gitdir = Path(git(wt, "rev-parse", "--path-format=absolute", "--git-dir") or wt)
    stamps = [float(git(wt, "log", "-1", "--format=%ct") or 0)]
    # Not the index: `git status` rewrites it, so it says nothing about agent activity.
    for p in (gitdir / "HEAD", gitdir / "logs" / "HEAD"):
        if p.exists():
            stamps.append(p.stat().st_mtime)
    return max(stamps)


def newest_mtime(path: Path) -> float:
    newest = path.lstat().st_mtime
    if path.is_dir() and not path.is_symlink():
        for root, dirs, files in os.walk(path):
            for name in dirs + files:
                try:
                    newest = max(newest, os.lstat(os.path.join(root, name)).st_mtime)
                except OSError:
                    pass
    return newest


def sweep_scratch(scratch: Optional[Path], apply: bool, cutoff: float, days: int, cwds: Optional[List[str]],
                  totals: Dict[str, int], emit) -> None:
    """Remove scratch entries untouched for --days, descending into active folders to find idle ones."""
    if scratch is None or not scratch.is_dir() or cwds is None:
        return

    def visit(d: Path, depth: int) -> None:
        for entry in sorted(d.iterdir()):
            if any(c == str(entry) or c.startswith(str(entry) + "/") for c in cwds):
                continue
            if newest_mtime(entry) >= cutoff:
                if depth < SCRATCH_DEPTH and entry.is_dir() and not entry.is_symlink():
                    visit(entry, depth + 1)
                continue
            kb = 0 if entry.is_symlink() else size_kb(entry)
            emit("scratch", "remove", str(entry), f"idle {days}+ days", kb)
            totals["scratch"] += 1
            if not apply:
                totals["reclaimable_kb"] += kb
                continue
            try:
                if entry.is_dir() and not entry.is_symlink():
                    shutil.rmtree(entry)
                else:
                    entry.unlink()
                totals["freed_kb"] += kb
            except OSError as err:
                emit("scratch", "error", str(entry), str(err))

    for tool in sorted(scratch.iterdir()):
        if tool.is_dir() and not tool.is_symlink():
            visit(tool, 1)


def sweep(roots: List[Path], apply: bool, days: int, fetch: bool, out=sys.stdout,
          scratch: Optional[Path] = None) -> Dict[str, int]:
    cwds = process_cwds()
    me = str(Path.cwd().resolve())
    cutoff = time.time() - days * 86400
    totals = {"worktrees": 0, "branches": 0, "node_modules": 0, "scratch": 0, "kept": 0, "freed_kb": 0, "reclaimable_kb": 0}

    def emit(kind: str, verdict: str, path: str, why: str, kb: int = 0) -> None:
        print(f"{kind}\t{verdict}\t{human(kb) if kb else '-'}\t{path}\t{why}", file=out)

    for found in sorted(find_repos(roots)):
        trees = worktrees(found)
        # Run from the main checkout: the folder the scan found may be a worktree this loop deletes.
        main = Path(trees[0]["worktree"]) if trees else found
        path = main if main.is_dir() else found
        repo = Repo(path, fetch)
        checked_out = {t.get("branch", "") for t in trees}
        base_name = (repo.base or "").removeprefix("refs/remotes/origin/")
        for t in trees[1:]:  # trees[0] is the main checkout
            wt = Path(t["worktree"])
            busy = cwds is None or me.startswith(str(wt)) or any(c == str(wt) or c.startswith(str(wt) + "/") for c in cwds)
            # Resolved, so a worktree reached through an app's folder link counts as inside its target.
            real = str(wt.resolve()) if wt.exists() else str(wt)
            inside = any(p == str(r) or p.startswith(str(r) + "/") for r in roots for p in (str(wt), real))
            if ("prunable" in t or not wt.exists()) and inside and "locked" not in t:
                emit("worktree", "remove", str(wt), "folder already gone")
                if apply:
                    git(path, "worktree", "prune")
                totals["worktrees"] += 1
                continue
            sha, branch = t.get("HEAD", ""), t.get("branch", "").removeprefix("refs/heads/")
            idle = last_activity(wt) < cutoff
            state = worktree_state(wt)
            if not inside:
                reason = "outside the scanned folders"
            elif "locked" in t:
                reason = "locked"
            elif busy:
                reason = "a process may be working in it" if cwds is not None else "running processes could not be checked"
            elif state is None:
                reason = "git status failed"
            elif branch == base_name:
                reason = "default branch"
            elif not idle and not (state and not state[0] and repo.finished(sha, branch)):
                reason = f"active in the last {days} days"
            elif state[1]:
                reason = state[1]
            else:
                reason = ""
            kb = size_kb(wt)
            if reason:
                totals["kept"] += 1
                emit("worktree", "keep", str(wt), reason, kb)
                stale = wt / "node_modules"
                if inside and idle and not busy and state is not None and "locked" not in t and stale.is_dir() and not stale.is_symlink():
                    nkb = size_kb(stale)
                    totals["node_modules"] += 1
                    emit("node_modules", "remove", str(stale), f"idle {days}+ days, reinstallable", nkb)
                    if apply:
                        try:
                            shutil.rmtree(stale)
                            totals["freed_kb"] += nkb
                        except OSError as err:
                            emit("node_modules", "error", str(stale), str(err))
                    else:
                        totals["reclaimable_kb"] += nkb
                continue
            lost = ["uncommitted changes"] if state and state[0] else []
            if repo.fetch_failed or not repo.base:
                lost.append("commits of unknown merge state")
            elif not repo.merged(sha):
                n = repo.unpushed(sha)
                lost.append(f"{n} unpushed commit(s)" if n else "unmerged commits")
            emit("worktree", "remove", str(wt), f"{f'idle {days}+ days' if idle else 'merged'} ({branch or 'detached'}; "
                 f"{'discards ' + ', '.join(lost) if lost else 'merged'})", kb)
            totals["worktrees"] += 1
            if not apply:
                totals["reclaimable_kb"] += kb
                continue
            # A finished worktree was clean, so drop --force: git refuses if edits landed since the check.
            if git_ok(path, "worktree", "remove", *([] if not idle else ["--force"]), str(wt)):
                totals["freed_kb"] += kb
                if branch:
                    git(path, "branch", "-D", branch)
            else:
                emit("worktree", "error", str(wt), "git worktree remove refused")
        current = git(path, "branch", "--show-current")
        label = Path(trees[0]["worktree"]).name if trees else path.name
        for line in git(path, "for-each-ref", "--format=%(refname:short) %(objectname)", "refs/heads").splitlines():
            name, sha = line.split()
            if name in (current, base_name) or f"refs/heads/{name}" in checked_out:
                continue
            if not repo.merged(sha):
                emit("branch", "keep", f"{label}:{name}", "not proven merged")
                continue
            emit("branch", "remove", f"{label}:{name}", "merged")
            totals["branches"] += 1
            if apply:
                git(path, "branch", "-D", name)
        if repo.pr_lookup_failed:
            emit("github", "warning", label, "merged-PR lookup failed; squash merges were not recognised")

    sweep_scratch(scratch, apply, cutoff, days, cwds, totals, emit)

    if shutil.which("xcrun") and not os.environ.get("AGENT_SWEEP_SKIP_SIMULATORS"):
        sims = run(["xcrun", "simctl", "list", "devices", "unavailable"], timeout=120).stdout
        count = sum(1 for l in sims.splitlines() if "(unavailable" in l)
        emit("simulators", "remove" if count else "keep", "unavailable", f"{count} unavailable")
        if apply and count and run(["xcrun", "simctl", "delete", "unavailable"], timeout=600).returncode != 0:
            emit("simulators", "error", "unavailable", "xcrun simctl delete unavailable failed")
    return totals


def main(argv: Optional[List[str]] = None) -> int:
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("roots", nargs="*", help=f"folders to scan (default: {' '.join(DEFAULT_ROOTS)})")
    p.add_argument("--apply", action="store_true", help="remove what the report marks 'remove'")
    p.add_argument("--days", type=int, default=5, help="idle days before an unmerged worktree, its node_modules or scratch is removed")
    p.add_argument("--no-fetch", action="store_true", help="skip 'git fetch --prune' before judging merges")
    a = p.parse_args(argv)
    if a.days < 0:
        p.error("--days must be 0 or more")
    roots = [Path(r).expanduser().resolve() for r in (a.roots or DEFAULT_ROOTS)]
    scratch = None if a.roots else Path(SCRATCH_ROOT).expanduser().resolve()
    t = sweep(roots, a.apply, a.days, not a.no_fetch, scratch=scratch)
    done = f"freed {human(t['freed_kb'])}" if a.apply else f"reclaimable {human(t['reclaimable_kb'])}"
    print(f"summary\tworktrees={t['worktrees']} branches={t['branches']} node_modules={t['node_modules']} scratch={t['scratch']} "
          f"kept={t['kept']} {done}{'' if a.apply else ' (report only; rerun with --apply)'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
