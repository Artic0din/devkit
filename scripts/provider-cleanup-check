#!/usr/bin/env python3
"""Read-only gates for provider cleanup. Run locally on the host being checked."""
import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import sys
import tarfile


def digest(stream) -> bytes:
    result = hashlib.sha256()
    for block in iter(lambda: stream.read(1024 * 1024), b""):
        result.update(block)
    return result.digest()


def check_archive(archive: Path, root: Path, registrations: list[str], payloads: list[str]) -> None:
    if not registrations or not payloads:
        raise ValueError("both registration and payload paths are required")
    if set(registrations) & set(payloads):
        raise ValueError("registration and payload paths must be distinct")
    with tarfile.open(archive, "r:*") as tar:
        files = {}
        for member in tar:
            name = str(Path(member.name))
            if name in files:
                raise ValueError("archive has duplicate member paths")
            files[name] = member
        for name in registrations + payloads:
            rel = Path(name)
            if rel.is_absolute() or ".." in rel.parts or rel == Path("."):
                raise ValueError("expected a relative path under the supplied root")
            live = root / rel
            if live.is_symlink() or not live.resolve().is_relative_to(root.resolve()):
                raise ValueError("required path resolves outside the backup scope or is a link")
            inputs = sorted(live.rglob("*")) if live.is_dir() and name in payloads else [live]
            regular = 0
            for path in inputs:
                if path.is_symlink():
                    raise ValueError("required payload contains a link; verify its target separately")
                if path.is_dir():
                    continue
                key = str(path.relative_to(root))
                member = files.get(key)
                if not path.is_file() or not member or not member.isfile():
                    raise ValueError(f"required regular file unavailable: {key}")
                if (member.mode ^ path.stat().st_mode) & 0o7777:
                    raise ValueError(f"archive permissions differ: {key}")
                if name in registrations and member.size == 0:
                    raise ValueError("empty registration file")
                with path.open("rb") as current, tar.extractfile(member) as saved:
                    if digest(current) != digest(saved):
                        raise ValueError(f"archive content differs: {key}")
                regular += 1
            if not regular:
                raise ValueError(f"no files verified for {name}")


def command(value: str) -> list[str]:
    args = json.loads(value)
    if not isinstance(args, list) or not args or not all(isinstance(arg, str) and arg for arg in args):
        raise ValueError("commands must be nonempty JSON arrays of strings")
    return args


def pilot(startup: str, catalog: str, expected: list[str]) -> None:
    subprocess.run(command(startup), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, check=True, timeout=30)
    output = subprocess.run(command(catalog), stdin=subprocess.DEVNULL, capture_output=True,
                            check=True, timeout=30)
    rows = json.loads(output.stdout)
    if not isinstance(rows, list):
        raise ValueError("expected the native catalog command to return a JSON array")
    names = set()
    for row in rows:
        if isinstance(row, str):
            names.add(row)
        elif isinstance(row, dict) and isinstance(row.get("name"), str):
            if row.get("enabled") is not False and not row.get("errors"):
                names.add(row["name"])
        else:
            raise ValueError("unknown catalog entry format")
    if set(expected) - names:
        raise ValueError("pilot catalog is missing expected skills")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    actions = parser.add_subparsers(dest="action", required=True)
    preflight = actions.add_parser("preflight")
    choice = preflight.add_mutually_exclusive_group(required=True)
    choice.add_argument("--archive", type=Path)
    choice.add_argument("--no-backup", action="store_true")
    preflight.add_argument("--root", type=Path, default=Path.home())
    preflight.add_argument("--registration", action="append", default=[])
    preflight.add_argument("--payload", action="append", default=[])
    check = actions.add_parser("pilot")
    check.add_argument("--startup", required=True, help="native startup probe as a JSON argument array")
    check.add_argument("--catalog", required=True, help="fresh native skill list as a JSON argument array")
    check.add_argument("--expect", action="append", required=True)
    args = parser.parse_args()
    try:
        if args.action == "pilot":
            pilot(args.startup, args.catalog, args.expect)
        elif args.no_backup:
            if args.registration or args.payload:
                parser.error("choose archive verification or explicit no-backup")
            print("Explicit no-backup choice recorded for this preflight.")
        else:
            check_archive(args.archive, args.root, args.registration, args.payload)
    except subprocess.SubprocessError:
        print("Provider probe failed or timed out.", file=sys.stderr)
        return 1
    except (OSError, ValueError, tarfile.TarError) as error:
        print(f"Check failed: {error}", file=sys.stderr)
        return 1
    print(f"Passed {args.action}.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
