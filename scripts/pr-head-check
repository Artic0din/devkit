#!/usr/bin/env python3
"""Check whether a reviewed commit is still the published head of an open PR."""
import argparse
import json
import re
import subprocess
import sys


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("repository", metavar="OWNER/REPO")
    parser.add_argument("number", type=int)
    parser.add_argument("commit", help="full SHA of the pushed fix or notification")
    args = parser.parse_args()
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", args.repository) or args.number < 1:
        parser.error("expected OWNER/REPO and a positive PR number")
    if not re.fullmatch(r"[a-fA-F0-9]{40}", args.commit):
        parser.error("expected a full 40-character commit SHA")
    try:
        result = subprocess.run(
            ["gh", "pr", "view", str(args.number), "--repo", args.repository,
             "--json", "state,headRefOid"], check=True, capture_output=True, timeout=20,
        )
        remote = json.loads(result.stdout)
        state, head = remote["state"], remote["headRefOid"]
        if state not in ("OPEN", "CLOSED", "MERGED") or not isinstance(head, str) or not re.fullmatch(r"[0-9a-f]{40}", head):
            raise ValueError("invalid PR metadata")
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        print("Could not verify the remote PR head.", file=sys.stderr)
        return 2
    print(f"{args.repository}#{args.number} {state} {head}")
    return 0 if state == "OPEN" and head == args.commit.lower() else 1


if __name__ == "__main__":
    sys.exit(main())
